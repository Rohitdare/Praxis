# Praxis Backend Environment Variables
# Port is automatically assigned by Render via $PORT (defaults to 8000 locally)
PORT=8000

# Comma-separated list of allowed CORS origins (no trailing slashes)
# Defaults to: https://praxis-memo.vercel.app,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://praxis-memo.vercel.app,http://localhost:5173,http://localhost:3000
